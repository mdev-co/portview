{
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local dev api"
    }
  ],
  "info": {
    "title": "SPS API",
    "description": "REST surface for the AIS vessel tracking project. The frontend consumes this spec via Orval to generate a typed client.",
    "version": "1.0.0",
    "license": {
      "name": "UNLICENSED"
    }
  },
  "components": {
    "schemas": {
      "VesselListResponse": {
        "type": "object",
        "properties": {
          "vessels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VesselSummary"
            }
          }
        },
        "required": ["vessels"]
      },
      "VesselSummary": {
        "type": "object",
        "properties": {
          "mmsi": {
            "type": "integer"
          },
          "imo": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "name": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "callSign": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "shipType": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "dimensions": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/VesselDimensions"
              }
            ]
          },
          "draught": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number"
              }
            ]
          },
          "destination": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "eta": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "lastSeenAt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "position": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/VesselPositionSummary"
              }
            ]
          },
          "kalmanState": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/VesselKalmanState"
              }
            ]
          }
        },
        "required": [
          "mmsi",
          "imo",
          "name",
          "callSign",
          "shipType",
          "dimensions",
          "draught",
          "destination",
          "eta",
          "lastSeenAt",
          "position",
          "kalmanState"
        ]
      },
      "VesselDimensions": {
        "type": "object",
        "properties": {
          "toBow": {
            "type": "integer"
          },
          "toStern": {
            "type": "integer"
          },
          "toPort": {
            "type": "integer"
          },
          "toStarboard": {
            "type": "integer"
          }
        },
        "required": ["toBow", "toStern", "toPort", "toStarboard"],
        "description": "Hull dimensions in metres relative to the GNSS antenna position.\nOrigin: ITU-R M.1371-5 type 5 ShipStaticData. Nullable as a group\nbecause either all four fields are reported together (from a single\ntype 5 message) or none are."
      },
      "VesselPositionSummary": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "speedOverGround": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number"
              }
            ]
          },
          "courseOverGround": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number"
              }
            ]
          },
          "trueHeading": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "navStatus": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              }
            ]
          },
          "rateOfTurn": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number"
              }
            ]
          },
          "broadcastTimestamp": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the most recent position report."
          }
        },
        "required": [
          "lat",
          "lng",
          "speedOverGround",
          "courseOverGround",
          "trueHeading",
          "navStatus",
          "rateOfTurn",
          "broadcastTimestamp",
          "updatedAt"
        ]
      },
      "VesselKalmanState": {
        "type": "object",
        "properties": {
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "vlng": {
            "type": "number"
          },
          "vlat": {
            "type": "number"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["lng", "lat", "vlng", "vlat", "updatedAt"],
        "description": "Persisted Kalman filter state for the constant-velocity 2D model.\nThe frontend re-attaches its filter to this state on cold-start so\nextrapolation continues smoothly instead of restarting from scratch.\nNull when the vessel has no position fix yet."
      },
      "ListVesselsQuery": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Maximum number of vessels to return."
          }
        },
        "required": []
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "tags": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "x-samchon-accessor": ["getHello"],
        "x-samchon-controller": "AppController"
      }
    },
    "/vessels": {
      "get": {
        "tags": [],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "required": false,
            "description": "Maximum number of vessels to return."
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VesselListResponse"
                }
              }
            }
          }
        },
        "x-samchon-accessor": ["vessels", "list"],
        "x-samchon-controller": "VesselsController"
      }
    },
    "/vessels/{mmsi}": {
      "get": {
        "tags": [],
        "parameters": [
          {
            "name": "mmsi",
            "in": "path",
            "schema": {
              "type": "number"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VesselSummary"
                }
              }
            }
          }
        },
        "x-samchon-accessor": ["vessels", "byMmsi"],
        "x-samchon-controller": "VesselsController"
      }
    }
  },
  "tags": []
}
