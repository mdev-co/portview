# Copy this file to /etc/sps-edge-bridge/edge-bridge.env on the Pi and
# fill in real values. Root-owned, 0640, readable by the systemd
# DynamicUser via the auto-created group. Never commit a populated copy.
#
# See apps/edge-bridge/src/config.ts for the authoritative defaults.

# Backend endpoint the bridge forwards NMEA frames to.
EDGE_BRIDGE_BACKEND_URL=

# Local UDP socket where rtl_ais writes NMEA. Defaults match rtl_ais
# out-of-the-box.
EDGE_BRIDGE_LOCAL_UDP_HOST=
EDGE_BRIDGE_LOCAL_UDP_PORT=

# Per-device client certificate. All three paths must be set together
# for the bridge to negotiate mTLS; missing any falls back to plain ws.
# In production all three are present.
EDGE_BRIDGE_CLIENT_CERT_PATH=
EDGE_BRIDGE_CLIENT_KEY_PATH=
EDGE_BRIDGE_CA_CERT_PATH=

# Optional reconnect / queue tuning. Sane defaults in code.
EDGE_BRIDGE_RECONNECT_INITIAL_MS=
EDGE_BRIDGE_RECONNECT_MAX_MS=
EDGE_BRIDGE_RECONNECT_JITTER_MS=
EDGE_BRIDGE_CONNECTION_TIMEOUT_MS=
EDGE_BRIDGE_SEND_QUEUE_LIMIT=
EDGE_BRIDGE_BACKPRESSURE_WARN_BYTES=
EDGE_BRIDGE_SHUTDOWN_GRACE_MS=

# Logger threshold: debug | info | warn | error.
EDGE_BRIDGE_LOG_LEVEL=
