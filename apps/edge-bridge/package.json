{
  "name": "@sps/edge-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "Pi-side UDP-to-WSS forwarder bridging rtl_ais output to the cloud-deployed apps/api ingest gateway over mTLS.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}