# Save with ^ prefix (allows minor/patch updates).
save-prefix="^"

# Pin to the official npm registry; no proxies.
registry=https://registry.npmjs.org/

# Drop funding messages to reduce noise on install.
fund=false

# Show warnings and errors only.
loglevel=warn

# Enforce engines from package.json - refuse install on mismatched node/pnpm.
engine-strict=true

# Cooldown window for newly published packages.
# Reduces blast radius of supply-chain attacks where a malicious version is
# pulled within hours of publication. Honored by pnpm 10.6+; older versions
# silently ignore it.
min-release-age=5
