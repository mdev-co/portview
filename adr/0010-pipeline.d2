direction: right
vars: {
  d2-config: {
    theme-id: 8
    pad: 20
  }
}

upstream: "Untrusted upstream" {
  udp: "Local UDP :10110\nNMEA bytes" {
    shape: hexagon
    icon: https://icons.terrastruct.com/dev%2Fnodejs.svg
  }
  ais: "AisStream WS\nJSON" {
    shape: hexagon
  }
}

api: "@sps/api (NestJS)" {
  shape: package
  icon: https://icons.terrastruct.com/dev%2Fnodejs.svg

  ingest: "IngestService" {
    shape: rectangle
    decoder: "Decoder + GIGO gate"
    fsm: "Priority FSM"
  }

  bus: "EventEmitter2 bus" {
    shape: cylinder
    pos: "vessel.update"
    static: "vessel.static.update"
  }

  gateway: "TelemetryWsGateway\n/ws/telemetry" {
    shape: rectangle
    onpos: "@OnEvent(vessel.update)\nencodeVesselFrame() -> 40B" {
      shape: rectangle
    }
    onstatic: "@OnEvent(vessel.static.update)\nbuildVesselStaticFrame() -> JSON" {
      shape: rectangle
    }
    bcast: "broadcast(payload, { binary })\nskips clients > 1MB buffered" {
      shape: rectangle
    }
  }
}

web: "@sps/web (React 19 + Vite)" {
  shape: package
  icon: https://icons.terrastruct.com/dev%2Freact.svg

  client: "telemetry-client.ts" {
    shape: rectangle
    dispatch: "dispatchTelemetryMessage(data)\nArrayBuffer -> binary\nstring  -> JSON.parse + isStaticFrame"
  }

  vessels: "vessels store (nanostores map)\nTTL 600s sweep 30s" {
    shape: cylinder
  }

  static_store: "vesselStaticData store (nanostores map)\nsweep-on-orphan vs vessels store" {
    shape: cylinder
  }

  ui: "VesselListItem" {
    shape: rectangle
    title_row: "Label slot: vesselName | MMSI"
    details: "Details slot: live + 7 static fields"
  }
}

upstream.udp -> api.ingest.decoder: "NMEA bytes"
upstream.ais -> api.ingest.decoder: "JSON"

api.ingest.decoder -> api.ingest.fsm: "AisMessage"
api.ingest.fsm -> api.bus.pos: "publishVesselUpdate" {
  style: { stroke-dash: 3 }
}
api.ingest.fsm -> api.bus.static: "publishVesselStatic\n(only when messageType === 5)" {
  style: { stroke-dash: 3 }
}

api.bus.pos -> api.gateway.onpos
api.bus.static -> api.gateway.onstatic
api.gateway.onpos -> api.gateway.bcast: "Uint8Array"
api.gateway.onstatic -> api.gateway.bcast: "string"

api.gateway.bcast -> web.client.dispatch: "binary VesselUpdateFrame\n+ JSON { kind: vessel.static }"

web.client.dispatch -> web.vessels: "setVessel(LiveVessel)"
web.client.dispatch -> web.static_store: "setVesselStatic(frame)"

web.vessels -> web.ui.title_row: "useSyncExternalStore (per MMSI)"
web.static_store -> web.ui.title_row: "useVesselStatic (per MMSI)"
web.vessels -> web.ui.details
web.static_store -> web.ui.details
