# Copy this file to .env (gitignored) and fill in real values for local dev.
# All apps in the monorepo read this single root .env via dotenv / ConfigModule
# / tsx --env-file-if-exists.

# --- apps/api ---
# Database connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# CORS allowlist for browser clients. Comma-separated origins.
CORS_ALLOWED_ORIGINS=

# --- ingest module ---
# External feed credentials.
EXTERNAL_FEED_API_KEY=
EXTERNAL_FEED_TOKEN=
EXTERNAL_FEED_ENDPOINT=

# --- apps/edge-bridge (Pi-to-cloud forwarder) ---
# Backend WSS endpoint the bridge connects to (apps/api EdgeIngestGateway).
EDGE_BRIDGE_BACKEND_URL=
# Local UDP socket on the Pi where rtl_ais writes NMEA.
EDGE_BRIDGE_LOCAL_UDP_HOST=
EDGE_BRIDGE_LOCAL_UDP_PORT=
# Per-device client certificate paths (mTLS, required from chunk 3).
EDGE_BRIDGE_CLIENT_CERT_PATH=
EDGE_BRIDGE_CLIENT_KEY_PATH=
EDGE_BRIDGE_CA_CERT_PATH=
# Optional reconnect / queue tuning (defaults sane: 1 s init, 30 s cap, 1 s jitter, 5 s handshake, 1000 frame queue, 64 KB backpressure, 5 s shutdown drain).
EDGE_BRIDGE_RECONNECT_INITIAL_MS=
EDGE_BRIDGE_RECONNECT_MAX_MS=
EDGE_BRIDGE_RECONNECT_JITTER_MS=
EDGE_BRIDGE_CONNECTION_TIMEOUT_MS=
EDGE_BRIDGE_SEND_QUEUE_LIMIT=
EDGE_BRIDGE_BACKPRESSURE_WARN_BYTES=
EDGE_BRIDGE_SHUTDOWN_GRACE_MS=
# Logger threshold: debug | info | warn | error (default info).
EDGE_BRIDGE_LOG_LEVEL=

# --- apps/web ---
# Base URL of the REST api consumed by the web client.
# Inlined by Vite at build time.
VITE_API_URL=

# WebSocket endpoint for live telemetry. Required when the web origin
# differs from the api origin (cross-origin deploy); falls back to
# the page origin otherwise. Inlined by Vite at build time.
VITE_WS_URL=

# --- OpenAPI exposure ---
# Two-condition guard for the Swagger UI and /api/docs-json. Both
# must be true to expose the spec: SPS_EXPOSE_OPENAPI exactly "true"
# AND NODE_ENV not "production". Default closed everywhere; set
# explicitly per developer machine to opt in.
SPS_EXPOSE_OPENAPI=

VITE_MAPTILER_KEY=

# Optional service overrides (defaults in code)
# SERVICE_PORT=
# SERVICE_HOST=
# RATE_LIMIT=

# System settings
# VERBOSITY_LEVEL=
# RUNTIME_MODE=
